# Contoh environment — tidak ada secret di repo ini.
# APK Builder tidak butuh env var apa pun untuk jalan:
# Personal Access Token GitHub dimasukkan pengguna di UI
# dan tidak pernah disimpan di server (lihat docs/security.md).
# File ini hanya penanda bahwa tidak ada .env yang dibutuhkan.
NEXT_TELEMETRY_DISABLED=1
