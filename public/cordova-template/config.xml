<?xml version='1.0' encoding='utf-8'?>
<!-- Template Cordova untuk APK Builder.
     Placeholder __APP_NAME__, __PACKAGE_NAME__, dan __TARGET_URL__
     diganti Pages Worker (worker/_worker.js) sebelum file ini di-push
     ke repo target lewat GitHub Contents API. -->
<widget id="__PACKAGE_NAME__" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>__APP_NAME__</name>
    <description>Aplikasi Android hasil APK Builder — membungkus __TARGET_URL__ di WebView.</description>
    <author email="noreply@apk-builder.pages.dev" href="https://apk-builder.pages.dev">APK Builder</author>
    <!-- Aplikasi langsung memuat URL target sebagai konten utama. -->
    <content src="__TARGET_URL__" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <icon density="ldpi" src="res/icon/android/icon-36-ldpi.png" />
        <icon density="mdpi" src="res/icon/android/icon-48-mdpi.png" />
        <icon density="hdpi" src="res/icon/android/icon-72-hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/icon-96-xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/icon-144-xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/icon-192-xxxhdpi.png" />
    </platform>
</widget>
